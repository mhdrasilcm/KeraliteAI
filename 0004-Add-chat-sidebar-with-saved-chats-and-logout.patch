+// Minimal single-weight line icons (DESIGN.md: ~16-20px monochrome strokes).
+type P = { className?: string };
+
+function Svg({ className = "h-20 w-20", children }: P & { children: React.ReactNode }) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.5"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      className={className}
+      aria-hidden="true"
+    >
+      {children}
+    </svg>
+  );
+}
+
