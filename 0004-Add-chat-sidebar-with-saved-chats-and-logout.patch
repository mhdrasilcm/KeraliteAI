+                onChange={(e) => setInput(e.target.value)}
+                placeholder="Ask about today's lesson…"
+                className="h-[48px] min-w-0 flex-1 bg-transparent px-12 text-body outline-none"
+              />
+              <Button type="submit" disabled={loading || !input.trim()}>
+                Ask
+              </Button>
+            </div>
+          </div>
+        </form>
+      </div>
     </div>
   );
 }
